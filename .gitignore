# ~/.claude is mostly Claude Code's own state (sessions, history, caches,
# credentials) and grows new files every release, so track an allowlist.
*
!.gitignore
!README.md
!setup
!settings.json
!mods/
!mods/**

# generated by Claude Code each time it loads a mod
mods/*/.claude-plugin/types/
mods/*/tsconfig.json

.DS_Store
